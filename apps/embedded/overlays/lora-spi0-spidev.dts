/dts-v1/;
/plugin/;

/* Expose the header SPI (controller 5010000, kernel "spi0", header pins 19/21/23/24 =
 * PC2/PC0/PC1/PC3) as a spidev node so the RFM95W on those pins can be reached.
 *
 * The base DTB declares a jedec,spi-nor "flash@0" on this chip select, so the NOR driver
 * claims it and no /dev/spidev0.x is ever created. The LoRa daemons were pointed at
 * /dev/spidev1.1 instead, which is the OTHER controller (5011000, the PH-bank pins the
 * touchscreen used) -- a bus the radio is not wired to.
 */
/ {
    compatible = "allwinner,sun50i-h618";

    fragment@0 {
        target-path = "/soc/spi@5010000";
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;

            flash@0 {
                status = "disabled";
            };

            spidev@0 {
                compatible = "rohm,dh2228fv";
                reg = <0>;
                spi-max-frequency = <1000000>;
                status = "okay";
            };
        };
    };
};
